[Unit]
Description=Docker secrets engine daemon (shim)
Documentation=https://github.com/chadsr/docker-secrets-engine-shim

[Service]
Type=simple
ExecStart=/usr/bin/docker-secrets-engine-shim
Restart=on-failure
RestartSec=2s

# Ensure a crash never leaves a core dump on disk
LimitCORE=0

[Install]
WantedBy=default.target
